# EditorConfig is awesome: https://EditorConfig.org

# top-most EditorConfig file
root = true

# Unix-style newlines with a newline ending every file
[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Matches markdown files
[*.md]
trim_trailing_whitespace = false

# JavaScript, TypeScript, Vue files
[*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,vue}]
end_of_line = lf

# JSON files
[*.json]
end_of_line = lf

# YAML files
[*.{yml,yaml}]
end_of_line = lf

# HTML files
[*.{html,htm}]
end_of_line = lf

# CSS/SCSS files
[*.{css,scss,sass}]
end_of_line = lf

# Shell scripts
[*.{sh,bash}]
end_of_line = lf

# Docker files
[Dockerfile]
end_of_line = lf

# Git config files
[.git*]
end_of_line = lf
